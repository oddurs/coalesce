#!/bin/sh
# Workflow driver: one unit of work -> one worktree -> one branch -> one PR.
set -eu

ROOT=$(cd "$(dirname "$0")/.." && pwd)
REPO=$(basename "$ROOT")
WT_ROOT=$(cd "$ROOT/.." && pwd)/.worktrees/$REPO
BRANCH_RE='^(feat|fix|chore|docs|perf|refactor|test)/[a-z0-9][a-z0-9._-]*$'
COMMIT_RE='^(feat|fix|chore|docs|perf|refactor|test|style|build|ci|revert)(\([a-z0-9._/-]+\))?!?: [^ ].{0,71}$'

die() { echo "agent: $*" >&2; exit 1; }
say() { echo "agent: $*"; }
has_origin() { git -C "$ROOT" remote get-url origin >/dev/null 2>&1; }
default_branch() {
  if has_origin; then
    git -C "$ROOT" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||' && return
  fi
  git -C "$ROOT" config init.defaultBranch 2>/dev/null || echo main
}

cmd_doctor() {
  rc=0
  for t in git cargo pnpm; do command -v "$t" >/dev/null || { echo "missing: $t"; rc=1; }; done
  command -v gh >/dev/null && { gh auth status >/dev/null 2>&1 || { echo "gh not authenticated"; rc=1; }; } \
    || echo "gh missing: pr/done need it"
  [ "$(git -C "$ROOT" config core.hooksPath)" = ".githooks" ] || {
    say "setting core.hooksPath=.githooks"; git -C "$ROOT" config core.hooksPath .githooks; }
  [ -z "$(git -C "$ROOT" status --porcelain)" ] || { echo "working tree not clean"; rc=1; }
  [ $rc -eq 0 ] && say "ok"
  return $rc
}

cmd_start() {
  b=${1:-}; echo "$b" | grep -Eq "$BRANCH_RE" || die "branch must match $BRANCH_RE"
  wt="$WT_ROOT/$b"
  [ -e "$wt" ] && die "worktree exists: $wt"
  git -C "$ROOT" show-ref --verify --quiet "refs/heads/$b" && die "branch exists: $b"
  d=$(default_branch)
  if has_origin; then git -C "$ROOT" fetch -q origin; base="origin/$d"; else base="$d"; fi
  say "creating $b from $base at $wt"
  mkdir -p "$(dirname "$wt")"
  git -C "$ROOT" worktree add -q -b "$b" "$wt" "$base"
  echo "$wt"
}

cmd_check() { "$ROOT/scripts/task" check; }

cmd_commit() {
  msg=${1:-}; [ -n "$msg" ] || die "usage: agent commit <message>"
  echo "$msg" | head -1 | grep -Eq "$COMMIT_RE" || die "not a conventional commit: $msg"
  git commit -q -m "$msg" && say "committed: $(git log -1 --format=%h)"
}

cmd_pr() {
  has_origin || die "no origin remote; publish the repo first"
  b=$(git rev-parse --abbrev-ref HEAD)
  [ "$b" != "$(default_branch)" ] || die "refusing to open a PR from the default branch"
  cmd_check
  git push -q -u origin "$b"
  gh pr create --fill "$@"
}

cmd_sync() {
  has_origin || die "no origin remote"
  git fetch -q origin && git rebase "origin/$(default_branch)"
}

cmd_done() {
  b=$(git rev-parse --abbrev-ref HEAD)
  [ "$b" != "$(default_branch)" ] || die "run done from the feature worktree"
  state=$(gh pr view "$b" --json state -q .state 2>/dev/null || echo NONE)
  [ "$state" = "MERGED" ] || die "PR for $b is $state, not MERGED"
  wt=$(pwd)
  cd "$ROOT"
  git worktree remove "$wt"
  git branch -D "$b"
  git worktree prune
  git fetch -q --prune origin
  say "cleaned up $b"
}

cmd_list() {
  git -C "$ROOT" worktree list
  command -v gh >/dev/null && has_origin && gh pr list --state open 2>/dev/null || true
}

cmd=${1:-}; [ $# -gt 0 ] && shift
case "$cmd" in
  doctor|start|check|commit|pr|sync|done|list) "cmd_$cmd" "$@" ;;
  *) echo "usage: scripts/agent {doctor|start <type>/<slug>|check|commit <msg>|pr [--draft]|sync|done|list}" >&2; exit 2 ;;
esac
