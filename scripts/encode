#!/bin/sh
# Encode a frame directory into a ProRes master and web deliverables.
# usage: scripts/encode [frames-dir] [out-dir]
set -eu
cd "$(dirname "$0")/.."
frames=${1:-out/frames}/png
out=${2:-out/video}
mkdir -p "$out"
n=$(ls "$frames"/frame_*.png | wc -l | tr -d ' ')
[ "$n" -eq 1440 ] || echo "warning: $n frames, expected 1440" >&2

# Master: ProRes 4444, full-range 4:4:4 10-bit, no loss the eye can find.
ffmpeg -y -loglevel error -stats -framerate 24 -i "$frames/frame_%04d.png" \
  -c:v prores_ks -profile:v 4 -pix_fmt yuv444p10le -vendor apl0 \
  -color_primaries bt709 -color_trc iec61966-2-1 -colorspace bt709 \
  "$out/master.mov"

# Web: sized to ship inside a static deploy (Vercel Hobby caps an upload at
# 100 MB). Settings were chosen by VMAF against the master: each file holds
# about 95, where the grain and gas stop showing losses. Capped at 2048 wide.
fit="scale='min(2048,iw)':-2:flags=lanczos"
ffmpeg -y -loglevel error -stats -i "$out/master.mov" -vf "$fit" \
  -c:v libsvtav1 -preset 4 -crf 30 -pix_fmt yuv420p10le -g 48 -movflags +faststart -an \
  "$out/loop-av1.mp4"
ffmpeg -y -loglevel error -stats -i "$out/master.mov" -vf "$fit" \
  -c:v libx265 -preset slow -crf 24 -pix_fmt yuv420p10le -tag:v hvc1 \
  -x265-params "keyint=48:min-keyint=48:no-open-gop=1:log-level=error" -movflags +faststart -an \
  "$out/loop-hevc.mp4"
# Phones, Data Saver and browsers without AV1 or HEVC.
ffmpeg -y -loglevel error -stats -i "$out/master.mov" -vf scale=1280:-2:flags=lanczos \
  -c:v libx264 -preset slow -crf 22 -pix_fmt yuv420p -g 48 -movflags +faststart -an \
  "$out/loop-720.mp4"
ffmpeg -y -loglevel error -i "$frames/frame_0000.png" -vf "$fit" -q:v 3 "$out/poster.jpg"
# The still shown instead of the loop when motion is reduced: the edge-on dance.
ffmpeg -y -loglevel error -i "$frames/frame_0816.png" -vf "$fit" -q:v 2 "$out/hero.jpg"
ls -la "$out"
