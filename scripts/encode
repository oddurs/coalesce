#!/bin/sh
# Encode the master into the web set, the song under each file from frame 0
# with silence filling the loop: AV1 and HEVC at 2048 wide, H.264 at 720p for
# phones and browsers without either, and the poster and reduced-motion
# stills. The set is served from R2 (scripts/publish), so it is sized for
# quality, not an upload cap: about VMAF 96 against the master. Check that on
# a new master before publishing, as the 75 s set was checked.
# usage: scripts/encode [master.mov] [song.wav] [out-dir]
set -eu
cd "$(dirname "$0")/.."
# Utility priority: the machine stays responsive for other work meanwhile.
if command -v taskpolicy >/dev/null 2>&1; then low="taskpolicy -c utility"; else low="nice -n 10"; fi
master=${1:-out/master.mov}
song=${2:-out/song-master.wav}
out=${3:-out/web}
mkdir -p "$out"
fit="scale='min(2048,iw)':-2:flags=lanczos"
audio="-map 0:v -map 1:a -af apad -shortest -c:a aac -b:a 160k"
$low ffmpeg -y -loglevel error -stats -i "$master" -i "$song" -vf "$fit" \
  -c:v libsvtav1 -preset 4 -crf 27 -pix_fmt yuv420p10le -g 48 $audio -movflags +faststart \
  "$out/loop-av1.mp4"
$low ffmpeg -y -loglevel error -stats -i "$master" -i "$song" -vf "$fit" \
  -c:v libx265 -preset slow -crf 22 -pix_fmt yuv420p10le -tag:v hvc1 \
  -x265-params "keyint=48:min-keyint=48:no-open-gop=1:log-level=error" $audio -movflags +faststart \
  "$out/loop-hevc.mp4"
$low ffmpeg -y -loglevel error -stats -i "$master" -i "$song" -vf scale=1280:-2:flags=lanczos \
  -c:v libx264 -preset slow -crf 21 -pix_fmt yuv420p -g 48 $audio -movflags +faststart \
  "$out/loop-720.mp4"
$low ffmpeg -y -loglevel error -i "$master" -vf "$fit" -frames:v 1 -q:v 3 "$out/poster.jpg"
# The still shown instead of the loop when motion is reduced: the edge-on
# eclipse on bar 22.
$low ffmpeg -y -loglevel error -ss 72.066 -i "$master" -vf "$fit" -frames:v 1 -q:v 2 "$out/hero.jpg"
ls -la "$out"
